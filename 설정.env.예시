# 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 값을 채우세요.
#   cp 설정.env.예시 .env
# .env 는 git에 올라가지 않습니다. 비밀번호를 여기에 두세요.

# 폰에서 들어올 때 쓸 비밀번호. 비워 두면 이 맥에서만 열립니다.
MARIKO_PASSWORD=

# 폰에서도 들어오려면 0.0.0.0 으로 두세요. 이 맥에서만 쓰려면 127.0.0.1.
# 0.0.0.0 으로 두면 비밀번호가 반드시 있어야 서버가 켜집니다.
MARIKO_HOST=127.0.0.1

# 마리코가 읽고 쓸 수 있는 폴더. 콜론(:)으로 나눠 적습니다.
MARIKO_ADD_DIR=$HOME/Desktop:$HOME/Documents

# 대화가 끝날 때마다 마리코/ 폴더를 git에 기록합니다. 끄려면 비워 두세요.
MARIKO_AUTOSAVE=commit
